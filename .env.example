# ==============================================================================
# NOTIQ AI — Security & Authentication Environment Configuration (.env.example)
# Copy this file to '.env' and populate with real production secrets before deployment.
# ==============================================================================

# Frontend API Base URL (For Netlify Frontend Deployment)
# Local: http://localhost:5000/api
# Production: https://your-backend-domain.com/api
VITE_API_BASE_URL=https://your-backend-domain.com/api

# Server Port & Environment Mode (Backend Only)
PORT=5000
NODE_ENV=production

# JWT Authentication Secrets (Backend Only - MUST BE STRONG UNIQUE RANDOM SECRETS IN PRODUCTION)
# Generate via: openssl rand -base64 64
JWT_SECRET=your_production_jwt_access_secret_min_64_bytes
REFRESH_TOKEN_SECRET=your_production_jwt_refresh_secret_min_64_bytes
OTP_SECRET=your_production_otp_signing_secret

# AES-256 Cloud Vault Encryption Key (Backend Only - Must be 32 bytes long)
VAULT_AES_KEY=your_production_aes_256_key_32_bytes_long!!

# CORS Allowed Origins (Comma-separated list of allowed frontend production domains)
CORS_ORIGIN=https://your-netlify-app.netlify.app

# Database Connection URL (Supports SQLite 'file:./notiq_production.db' or PostgreSQL connection string)
DATABASE_URL=file:./notiq_production.db

# Development Only Flag (STRICTLY MUST BE 'false' IN PRODUCTION)
SHOW_DEV_OTP=false

# External Email Provider Configuration (Backend Only - Mailjet Credentials)
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_FROM_EMAIL=your_verified_from_email
MAILJET_FROM_NAME=Notiq AI
